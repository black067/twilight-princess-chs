{
    "dusklight_exe": "<dusklight.exe 的路径，仅扫符号用，可留空>",

    "out": "dist",
    "mods_dir": "<游戏的 mod 目录（放 .dusk）：dusklight 2.x 是 exe 同级的 mods/，dusk-cn 是 <游戏目录>/data/mods/>",
    "game_config": "<游戏配置 json：dusklight 2.x 是数据目录下的 config.json，dusk-cn 是 <游戏目录>/data/config.json>",

    "input_dir": "input",
    "default_lang": "zh-Hans",
    "font_source": "input/font",

    "bundle": {
        "meta": {
            "id": "yiga.cn.eu",
            "name": "Chinese Translation",
            "version": "1.1.0",
            "author": "Yiga Clan",
            "description": "Chinese translation for Twilight Princess on any GC or Wii disc. Pick your game language in the mod panel; Simplified, Traditional and DeepSeek-revised text included.",
            "icon": "assets/icon.png",
            "banner": "assets/banner.png"
        },
        "translations": [
            { "lang": "zh-Hans", "label": "Simplified Chinese" },
            { "lang": "zh-Hant", "label": "Traditional Chinese" },
            { "lang": "cn", "label": "Simplified Chinese (DeepSeek)" }
        ],
        "default_translation": "zh-Hans",
        "font_regions": [ "us", "eu", "jp" ],
        "locales": [
            { "code": "us", "label": "English (US disc)", "region": "us" },
            { "code": "uk", "label": "English (EU disc)", "region": "eu" },
            { "code": "de", "label": "German", "region": "eu" },
            { "code": "fr", "label": "French", "region": "eu" },
            { "code": "sp", "label": "Spanish", "region": "eu" },
            { "code": "it", "label": "Italian", "region": "eu" },
            { "code": "jp", "label": "Japanese", "region": "jp" }
        ],
        "default_locales": [ "fr" ],
        "ui": {
            "label_translation": "Translation",
            "section_locale": "Game language",
            "hint": "Text applies on the next load. Fonts need a game restart."
        }
    },

    "langs": {
        "zh-Hans": {
            "source": "input/msg",
            "src_file": "input/texts.zh-Hans.src.csv",
            "src_col": "cn",
            "locale_col": "zh-Hans",
            "default_name_chars": "林克伊波娜",
            "default_name_cells": [ "zel_00/898", "zel_00/899" ],
            "discs": [
                { "region": "us", "language": "us" },
                { "region": "eu", "language": "fr" },
                { "region": "jp", "language": "jp" }
            ],
            "mod": {
                "id": "yiga.zh.hans.{region}",
                "name": "Chinese (Simplified) Translation",
                "version": "1.0.4",
                "author": "Yiga Clan",
                "description": "A Chinese (Simplified) translation mod",
                "icon": "assets/icon.png",
                "banner": "assets/banner.png"
            },
            "mod_origin": {
                "id": "orig.zh.hans.{region}",
                "name": "Chinese (Simplified) Translation (bitmap font)",
                "version": "1.0.4",
                "author": "Yiga Clan",
                "description": "A Chinese (Simplified) translation mod",
                "icon": "assets/icon.png",
                "banner": "assets/banner.png"
            }
        },
        "zh-Hant": {
            "source": "input/msg",
            "src_file": "input/texts.zh-Hant.src.csv",
            "src_col": "cn",
            "locale_col": "zh-Hant",
            "keyboard_glyphs": "data/keyboard_glyphs.zh-Hant.json",
            "default_name_chars": "林克伊波娜",
            "default_name_cells": [ "zel_00/898", "zel_00/899" ],
            "fonts": {
                "fontres": { "file": "work/fonts/NotoSansCJKtc-Regular.otf" }
            },
            "discs": [
                { "region": "us", "language": "us" },
                { "region": "eu", "language": "fr" },
                { "region": "jp", "language": "jp" }
            ],
            "mod": {
                "id": "yiga.zh.hant.{region}",
                "name": "Chinese (Traditional) Translation",
                "version": "1.0.4",
                "author": "Yiga Clan",
                "description": "A Chinese (Traditional) translation mod",
                "icon": "assets/icon.zh-Hant.png",
                "banner": "assets/banner.png"
            }
        },
        "cn": {
            "source": "input/msg_us",
            "src_file": "input/texts.cn.src.csv",
            "src_col": "en",
            "locale_file": "data/texts.cn.csv",
            "locale_col": "cn",
            "default_name_chars": "林克伊波娜",
            "default_name_cells": [ "zel_00/898", "zel_00/899" ],
            "discs": [
                { "region": "us", "language": "us" },
                { "region": "eu", "language": "fr" },
                { "region": "jp", "language": "jp" }
            ],
            "mod": {
                "id": "yiga.cn.{region}",
                "name": "Chinese Translation (DeepSeek Ver)",
                "version": "1.0.4",
                "author": "Yiga Clan",
                "description": "Chinese translation translated from English (US) text by an AI.",
                "icon": "assets/icon.png",
                "banner": "assets/banner.png"
            }
        }
    },

    "fonts": {
        "fontres": {
            "file": "work/fonts/NotoSansCJKsc-Regular.otf",
            "em": 46,
            "gamma": 0.9
        },
        "rubyres": {
            "file": "work/fonts/LXGWWenKai-Regular.ttf",
            "em": 39,
            "gamma": 0.9
        }
    },

    "repo": "https://github.com/black067/twilight-princess-chs"
}
